{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build && python scripts/build_vercel.py",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,.venv/**,frontend/node_modules/**,.git/**,repoguard-*.jpg}"
    }
  }
}
